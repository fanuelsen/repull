{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "gitAuthor": "Renovate Bot <renovate@forgejo.sublog.org>",

  "packageRules": [
    {
      "description": "Use bump strategy for Go toolchain version in go.mod",
      "matchManagers": ["gomod"],
      "matchDepNames": ["go"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Indirect go.mod deps are skipped by default; enable them so vulnerable transitive deps get bumped too",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["indirect"],
      "enabled": true
    },
    {
      "description": "Group Go toolchain (go.mod) and golang Docker image into one PR",
      "matchDepNames": ["go", "golang"],
      "groupName": "Go",
      "groupSlug": "go"
    },
    {
      "description": "Auto-merge minor and patch Go toolchain updates",
      "matchDepNames": ["go", "golang"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "labels": ["dependencies", "go-toolchain"]
    },
    {
      "description": "Auto-merge minor and patch updates for other Docker base images",
      "matchDatasources": ["docker"],
      "matchDepNames": ["!golang"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Require manual review for major Docker image updates",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major-update"]
    },
    {
      "description": "Auto-merge minor and patch updates for Go dependencies",
      "matchDatasources": ["go"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Require manual review for major updates",
      "matchDatasources": ["go"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major-update"]
    },
    {
      "description": "Same group as the toolchain: govulncheck in CI fails on any fixable vuln, so separate toolchain and module PRs can block each other",
      "matchDatasources": ["go"],
      "groupName": "Go",
      "groupSlug": "go"
    },
    {
      "description": "GitHub Actions in the mirrored release workflow: one weekly PR, auto-merge everything but majors",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "schedule": ["* 0-5 * * 1"]
    },
    {
      "description": "Woodpecker doesn't run the GitHub workflow, so CI can't catch a broken action; digest/minor/patch within a pinned major is low risk",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest", "pin", "pinDigest", "minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    }
  ],

  "timezone": "Europe/Oslo",

  "postUpdateOptions": ["gomodTidy"],

  "customManagers": [
    {
      "customType": "regex",
      "description": "Update pinned 'go install' tool versions annotated with a renovate comment",
      "managerFilePatterns": ["/(^|/)\\.woodpecker\\.yml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\n\\s*- go install \\S+@(?<currentValue>v[0-9.]+)"
      ]
    }
  ],

  "rebaseWhen": "behind-base-branch",

  "prConcurrentLimit": 3,
  "prHourlyLimit": 0,

  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Dependency Dashboard",
  "dependencyDashboardAutoclose": true,

  "commitMessagePrefix": "chore(deps):",
  "commitMessageAction": "update",
  "commitMessageExtra": "to {{newVersion}}",

  "prBodyColumns": ["Package", "Update", "Type", "Change"],
  "prBodyNotes": ["{{#if (or (containsString updateType 'major') (containsString updateType 'minor'))}}:warning: This update includes breaking changes or new features. Please review carefully.{{/if}}"],

  "assigneesFromCodeOwners": true,
  "reviewersFromCodeOwners": true
}
